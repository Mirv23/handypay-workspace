# ─────────────────────────────────────────────────────────────────────
#  HandyPay · Espace d'équipe — variables d'environnement
#  Copie ce fichier en `.env` (ignoré par git) et remplis les valeurs.
#  NE METS JAMAIS de vraie clé dans ce fichier-ci : il est versionné.
# ─────────────────────────────────────────────────────────────────────

# local (sans base, données dans .data/) ou production.
# Par défaut : local si SUPABASE_URL est vide, production sinon.
APP_ENV=

# Secret de signature des sessions : 32 caractères au moins, aléatoire.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Obligatoire en production. En local, vide = généré dans .data/.
SESSION_SECRET=

# Durée d'une session, en heures (168 = 7 jours).
SESSION_MAX_AGE_HOURS=168

# Cookies « Secure » (HTTPS seulement). Par défaut : oui en production, non en local.
COOKIE_SECURE=

# Supabase (production). Vide = mode local avec .data/.
SUPABASE_URL=
# Clé SERVICE (service_role / secret), jamais la clé « anon » : elle reste sur le serveur.
SUPABASE_SERVICE_KEY=

# Dossier des données en mode local.
LOCAL_DATA_DIR=.data

# Adresse publique de l'espace (liens des e-mails, message d'invitation WhatsApp).
WORKSPACE_PUBLIC_URL=http://127.0.0.1:8000
# Adresse que GitHub et l'IA appellent (par défaut : WORKSPACE_PUBLIC_URL).
WORKSPACE_API_URL=

# Porte de l'IA : jeton de 32 caractères au moins (même valeur côté agent).
WORKSPACE_IA_TOKEN=

# GitHub : secret du webhook, et dépôt « organisation/depot » (facultatif).
WORKSPACE_GITHUB_SECRET=
WORKSPACE_GITHUB_REPO=

# E-mail du matin : heure locale (Port-au-Prince), jours ISO, fréquence de vérification (0 = arrêt).
WORKSPACE_DIGEST_HOUR=7
WORKSPACE_DIGEST_DAYS=1-7
WORKSPACE_DIGEST_INTERVAL_S=600

# Envoi des e-mails : EMAIL_FROM + (RESEND_API_KEY ou SMTP_*).
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_PROVIDER=
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=1
